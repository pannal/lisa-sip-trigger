# Prebuilt image; use :0.1.1 instead of :latest to pin this release.
LISA_IMAGE=pannal/lisa-sip-trigger:latest
# Documentation address: replace with your ATA's LAN address.
ATA_HOST=192.0.2.10
ATA_PORT=5061
ATA_USER=lisa
RING_SECONDS=2
RETRIGGER_INTERVAL=32
MAX_ALARM_SECONDS=1800
ERROR_RETRY_SECONDS=5
HTTP_BIND=0.0.0.0
HTTP_PORT=18080
# Optional; generate a token with: openssl rand -hex 24
API_TOKEN=
LOG_LEVEL=INFO
